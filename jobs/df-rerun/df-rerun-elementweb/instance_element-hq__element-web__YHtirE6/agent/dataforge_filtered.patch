+WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+See the License for the specific language governing permissions and
+limitations under the License.
+*/
+
+import { MatrixClient, MatrixEvent, RoomMember, RoomMemberEvent } from "matrix-js-sdk/src/matrix";
+import { IMatrixProfile } from "matrix-js-sdk/src/@types/search";
+
+import { LruCache } from "../utils/LruCache";
+
+const CACHE_SIZE = 500;
+
+/**
+ * Provides cached access to user profiles.
+ *
+ * The store keeps two caches:
+ * - profiles fetched for any user, and
+ * - profiles fetched for users known to share at least one room with us.
+ *
+ * Membership events are used to invalidate cached profiles when a member's
+ * display name or avatar changes.
+ */
+export class UserProfilesStore {
+    private readonly profiles = new LruCache<string, IMatrixProfile | null>(CACHE_SIZE);
+    private readonly knownProfiles = new LruCache<string, IMatrixProfile | null>(CACHE_SIZE);
+
+    public constructor(private readonly client: MatrixClient) {
+        this.client.on(RoomMemberEvent.Membership, this.onRoomMemberMembership);
+    }
+
+    /**
+     * Synchronously get a profile from the store cache.
+     * Returns the profile if cached, null if it does not exist, or undefined if not cached.
+     */
+    public getProfile(userId: string): IMatrixProfile | null | undefined {
+        return this.profiles.get(userId);
+    }
+
+    /**
+     * Synchronously get a profile from the known-users cache.
+     * Known users share at least one room with the current user.
+     * Returns the profile if cached, null if it does not exist, or undefined if not cached.
+     */
+    public getOnlyKnownProfile(userId: string): IMatrixProfile | null | undefined {
+        if (!this.isKnownUser(userId)) {
+            return undefined;
+        }
+
+        return this.knownProfiles.get(userId);
+    }
+
+    /**
+     * Asynchronously fetches a profile from the API and stores the result in the all-profiles cache.
+     */
+    public async fetchProfile(userId: string): Promise<IMatrixProfile | null> {
+        const cachedProfile = this.getProfile(userId);
+        if (cachedProfile !== undefined) {
+            return cachedProfile;
+        }
+
+        try {
+            const profile = (await this.client.getProfileInfo(userId)) ?? null;
+            this.profiles.set(userId, profile);
+            return profile;
+        } catch (error) {
+            this.profiles.set(userId, null);
+            return null;
+        }
+    }
+
+    /**
+     * Asynchronously fetches a profile from the API for a known user and stores the result in the
+     * known-users cache.
+     * Returns undefined if the user is unknown.
+     */
+    public async fetchOnlyKnownProfile(userId: string): Promise<IMatrixProfile | null | undefined> {
+        if (!this.isKnownUser(userId)) {
+            return undefined;
+        }
+
+        const cachedProfile = this.knownProfiles.get(userId);
+        if (cachedProfile !== undefined) {
+            return cachedProfile;
+        }
+
+        const profile = await this.fetchProfile(userId);
+        this.knownProfiles.set(userId, profile);
+        return profile;
+    }
+
+    /**
+     * A user is known when at least one room returned by the client contains a member for the user.
+     */
+    private isKnownUser(userId: string): boolean {
+        return this.client.getRooms().some((room) => !!room.getMember(userId));
+    }
+
+    private onRoomMemberMembership = (_event: MatrixEvent, member: RoomMember): void => {
+        const displayName = member.rawDisplayName;
+        const avatarUrl = member.getMxcAvatarUrl();
+
+        const hasChanged = (profile: IMatrixProfile | null | undefined): boolean => {
+            if (profile === undefined) {
+                return false;
+            }
+
+            return profile?.displayname !== displayName || profile?.avatar_url !== avatarUrl;
+        };
+
+        if (hasChanged(this.profiles.get(member.userId)) || hasChanged(this.knownProfiles.get(member.userId))) {
+            this.profiles.delete(member.userId);
+            this.knownProfiles.delete(member.userId);
+        }
+    };
+}
