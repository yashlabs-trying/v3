+def find_keys(d: Union[dict, list]) -> Iterator[str]:
+    """Recursively yield every string value stored under a ``key`` field in a
+    nested ``dict`` or ``list``.
+
+    Only ``dict`` and ``list`` values are traversed; other data types are not
+    recursed into and their values are not emitted.
+    """
+    if isinstance(d, dict):
+        for key, value in d.items():
+            if key == 'key' and isinstance(value, str):
+                yield value
+            elif isinstance(value, (dict, list)):
+                yield from find_keys(value)
+    elif isinstance(d, list):
+        for value in d:
+            if isinstance(value, (dict, list)):
+                yield from find_keys(value)
+
