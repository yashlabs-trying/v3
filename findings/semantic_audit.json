        "id": "find_keys.depth",
        "kind": "POSTCONDITION",
        "source": "instruction.md Requirements bullet 1",
        "statement": "find_keys(d) yields, in traversal order, every string value stored under a 'key' field at any nesting depth within a dict or list.",
        "tested_by_original": [
          "scripts/tests/test_new_solr_updater.py::TestParseLog::test_action_save",
          "scripts/tests/test_new_solr_updater.py::TestParseLog::test_move_edition"
        ]
      },
      {
        "id": "find_keys.types",
        "kind": "INVARIANT",
        "source": "instruction.md Requirements bullet 1",
        "statement": "find_keys must not recurse into or emit values for non-dict/list types.",
        "tested_by_original": []
      },
      {
        "id": "parse_log.one_key_per_doc",
        "kind": "POSTCONDITION",
        "source": "instruction.md Requirements bullet 2",
        "statement": "For 'save' and 'save_many', parse_log yields exactly one key per doc in changeset['docs']: that doc's own top-level 'key'.",
        "tested_by_original": [
          "scripts/tests/test_new_solr_updater.py::TestParseLog::test_action_save",
          "scripts/tests/test_new_solr_updater.py::TestParseLog::test_move_edition",
