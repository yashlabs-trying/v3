    "clauses": [
      {
        "id": "bearer.exact",
        "kind": "POSTCONDITION",
        "source": "instruction.md Requirements bullet 1",
        "statement": "Authorization metadata must be exactly \"Bearer <token>\" with a capital B and a single space; any other format is unauthenticated.",
        "tested_by_original": [
          "TestUnaryInterceptor/client_token_missing_Bearer_prefix",
          "TestUnaryInterceptor/malformed_authorization_header_with_valid_cookie",
          "TestUnaryInterceptor/authorization_header_empty"
        ]
      },
      {
        "id": "cookie.fallback",
        "kind": "POSTCONDITION",
        "source": "instruction.md Requirements bullet 2",
        "statement": "When no authorization header is present, extract the token from cookies in grpcgateway-cookie under key flipt_client_token, handling multiple cookies.",
        "tested_by_original": [
          "TestUnaryInterceptor/successful_authentication_(cookie_header)"
        ]
      },
      {
        "id": "header.precedence",
        "kind": "INVARIANT",
        "source": "instruction.md Requirements bullet 3",
        "statement": "When both authorization header and cookie are present, prefer the header and do not fall back to the cookie.",
        "tested_by_original": [
          "TestUnaryInterceptor/authorization_header_preferred_over_cookie"
        ]
      },
      {
        "id": "header.malformed.no_fallback",
        "kind": "ERROR_BEHAVIOR",
        "source": "instruction.md Requirements bullet 4",
        "statement": "A present-but-malformed authorization header must be rejected as unauthenticated without falling back to the cookie.",
        "tested_by_original": [
          "TestUnaryInterceptor/malformed_authorization_header_with_valid_cookie"
        ]
      },
      {
        "id": "cookie.multiple",
        "kind": "EDGE_CASE",
        "source": "instruction.md Requirements bullet 2",
        "statement": "A grpcgateway-cookie header carrying multiple cookies must still yield the flipt_client_token value; unrelated cookies are ignored.",
        "tested_by_original": []
      },
      {
        "id": "bypass.membership",
        "kind": "POSTCONDITION",
        "source": "instruction.md Requirements bullet 8/9",
        "statement": "Only servers registered via WithServerSkipsAuthentication bypass auth; a non-matching server does not bypass and is still validated.",
        "tested_by_original": [
          "TestUnaryInterceptor/successful_authentication_(skipped)"
        ]
      },
      {
        "id": "bypass.before_extraction",
        "kind": "INVARIANT",
        "source": "instruction.md Requirements bullet 9",
        "statement": "The bypass check runs before any metadata extraction, so a skipped server succeeds even with no metadata at all.",
        "tested_by_original": [
          "TestUnaryInterceptor/successful_authentication_(skipped)"
        ]
      },
      {
        "id": "expiry",
        "kind": "POSTCONDITION",
        "source": "instruction.md Requirements bullet 6",
        "statement": "An expired token must be rejected with errUnauthenticated.",
        "tested_by_original": [
          "TestUnaryInterceptor/token_has_expired"
        ]
      }
    ],
